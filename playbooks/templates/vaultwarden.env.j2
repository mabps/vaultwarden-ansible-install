DATA_FOLDER={{ vaultwarden_data_dir }}/

DATABASE_URL={{ vaultwarden_database_url }}

DATABASE_MAX_CONNS={{ vaultwarden_database_max_connections }}

WEB_VAULT_FOLDER={{ vaultwarden_web_vault_folder }}

WEB_VAULT_ENABLED={{ vaultwarden_web_vault_enabled | lower }}

ROCKET_ADDRESS={{ vaultwarden_bind_address }}

ROCKET_PORT={{ vaultwarden_port }}

DOMAIN={{ vaultwarden_domain }}

WEBSOCKET_ENABLED={{ vaultwarden_websocket_enabled | lower }}

WEBSOCKET_PORT={{ vaultwarden_websocket_port }}

LOG_LEVEL={{ vaultwarden_log_level }}

LOG_TIMESTAMP_FORMAT={{ vaultwarden_log_timestamp_format }}

SIGNUPS_ALLOWED={{ vaultwarden_allow_signups | lower }}

INVITATIONS_ALLOWED={{ vaultwarden_allow_invitations | lower }}

{% if vaultwarden_admin_enabled and vaultwarden_admin_token | length > 0 %}
ADMIN_TOKEN={{ vaultwarden_admin_token }}
{% endif %}
