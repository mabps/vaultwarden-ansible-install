[Unit]
Description=Vaultwarden Bitwarden compatible server
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple

User={{ vaultwarden_user }}
Group={{ vaultwarden_group }}

WorkingDirectory={{ vaultwarden_install_dir }}

EnvironmentFile={{ vaultwarden_install_dir }}/vaultwarden.env

ExecStart={{ vaultwarden_binary }}

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

ReadWritePaths={{ vaultwarden_data_dir }}

CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
