# HTTP -> HTTPS redirect
server {
    listen {{ nginx_http_port }};
    listen [::]:{{ nginx_http_port }};

    server_name {{ nginx_server_name }};

    return 301 https://$host$request_uri;
}

# HTTPS Vaultwarden
server {
    listen {{ nginx_https_port }} ssl;
    listen [::]:{{ nginx_https_port }} ssl;

    server_name {{ nginx_server_name }};

    ssl_certificate {{ vaultwarden_tls_certificate }};
    ssl_certificate_key {{ vaultwarden_tls_certificate_key }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 128M;

    # Main Vaultwarden/Web Vault
    location / {
        proxy_pass http://{{ vaultwarden_bind_address }}:{{ vaultwarden_port }};

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;

        proxy_read_timeout 300;
        proxy_send_timeout 300;
    }

    # Vaultwarden WebSocket endpoint
    location /notifications/hub {
        proxy_pass http://{{ vaultwarden_bind_address }}:{{ vaultwarden_websocket_port }};

        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    location /notifications/hub/negotiate {
        proxy_pass http://{{ vaultwarden_bind_address }}:{{ vaultwarden_port }};

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
